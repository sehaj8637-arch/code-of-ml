# EXPERIMENT-4 Implement Naive Bayes, Support Vector Machine (SVM),

# Naive Bayes vs SVM Classification

# 1. Import required libraries
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt

from sklearn.model_selection import train_test_split
from sklearn.preprocessing import StandardScaler

from sklearn.naive_bayes import GaussianNB
from sklearn.svm import SVC

from sklearn.metrics import (
    accuracy_score,
    precision_score,
    recall_score,
    f1_score,
    confusion_matrix,
    classification_report,
    ConfusionMatrixDisplay
)

# 2. Load Dataset

# Load from the provided CSV file
df_loaded = pd.read_csv('modified_data.csv')

# Assuming the last column is the target variable (y) and others are features (X)

columns_to_drop = ['date', 'street', 'city', 'statezip']
X_numeric = df_loaded.drop(columns=columns_to_drop + [df_loaded.columns[-1]])
y_continuous = df_loaded.iloc[:, -1].values # Store original continuous target

# Convert continuous target into discrete classes for classification

bins_qcut = pd.qcut(y_continuous, q=3, labels=['Low', 'Medium', 'High'], duplicates='drop')
y = bins_qcut.codes


# Extract feature names for the numeric features
feature_names = X_numeric.columns.tolist()
target_names = list(bins_qcut.categories)

X = X_numeric.values

print("Dataset Shape:", X.shape)
print("Number of Classes:", len(np.unique(y)))
print("Classes:", target_names)

# 3. Convert into DataFrame (for display purposes, mainly)
df = pd.DataFrame(X, columns=feature_names)
df["target"] = y_continuous
print("\nFirst 5 rows:")
print(df.head())

# 4. Check missing values

print("\nMissing Values:")
print(df.isnull().sum().sum())

# 5. Split Dataset into Training and Testing Sets

X_train, X_test, y_train, y_test = train_test_split(
    X,
    y,
    test_size=0.20,
    random_state=42,
    stratify=y # Stratify using the new binned target variable
)

print("\nTraining samples:", X_train.shape[0])
print("Testing samples:", X_test.shape[0])

# 6. Feature Scaling

scaler = StandardScaler()

X_train_scaled = scaler.fit_transform(X_train)
X_test_scaled = scaler.transform(X_test)


# 7. Create Models

# Naive Bayes
nb_model = GaussianNB()

# Support Vector Machine
svm_model = SVC(
    kernel="rbf",
    random_state=42
)

# 8. Train Naive Bayes Model

nb_model.fit(X_train_scaled, y_train)

# Prediction
y_pred_nb = nb_model.predict(X_test_scaled)

# 9. Train SVM Model

svm_model.fit(X_train_scaled, y_train)

# Prediction
y_pred_svm = svm_model.predict(X_test_scaled)

# 10. Evaluation Function

def evaluate_model(model_name, y_test, y_pred):

    accuracy = accuracy_score(y_test, y_pred)
    # Handle cases where precision/recall might be undefined for some classes
    precision = precision_score(y_test, y_pred, average='weighted', zero_division=0)
    recall = recall_score(y_test, y_pred, average='weighted', zero_division=0)
    f1 = f1_score(y_test, y_pred, average='weighted', zero_division=0)

    print("\n======================================")
    print(model_name)
    print("======================================")

    print("Accuracy :", round(accuracy, 4))
    print("Precision:", round(precision, 4))
    print("Recall   :", round(recall, 4))
    print("F1-Score :", round(f1, 4))

    print("\nClassification Report:")
    print(classification_report(
        y_test,
        y_pred,
        target_names=target_names # Use the extracted target_names
    ))

    print("Confusion Matrix:")
    print(confusion_matrix(y_test, y_pred))

    return accuracy, precision, recall, f1


# 11. Evaluate Naive Bayes

nb_results = evaluate_model(
    "Naive Bayes",
    y_test,
    y_pred_nb
)

# 12. Evaluate SVM

svm_results = evaluate_model(
    "Support Vector Machine (SVM)",
    y_test,
    y_pred_svm
)

# 13. Compare Models

comparison = pd.DataFrame({
    "Metric": [
        "Accuracy",
        "Precision",
        "Recall",
        "F1-Score"
    ],

    "Naive Bayes": nb_results,

    "SVM": svm_results
})

print("\n======================================")
print("MODEL COMPARISON")
print("======================================")

print(comparison)

# 14. Plot Performance Comparison

comparison.set_index("Metric").plot(
    kind="bar",
    figsize=(10, 6)
)

plt.title("Naive Bayes vs SVM Performance")
plt.ylabel("Score")
plt.ylim(0, 1.1)
plt.xticks(rotation=0)
plt.legend()
plt.grid(axis="y")
plt.show()

# 15. Confusion Matrix - Naive Bayes

cm_nb = confusion_matrix(y_test, y_pred_nb)

disp_nb = ConfusionMatrixDisplay(
    confusion_matrix=cm_nb,
    display_labels=target_names # Use the extracted target_names
)

disp_nb.plot()
plt.title("Naive Bayes Confusion Matrix")
plt.show()

# 16. Confusion Matrix - SVM

cm_svm = confusion_matrix(y_test, y_pred_svm)

disp_svm = ConfusionMatrixDisplay(
    confusion_matrix=cm_svm,
    display_labels=target_names # Use the extracted target_names
)

disp_svm.plot()
plt.title("SVM Confusion Matrix")
plt.show()

# 17. Determine Best Model

if svm_results[3] > nb_results[3]:
    print("\nSVM performed better based on F1-score.")
else:
    print("\nNaive Bayes performed better based on F1-score.")
