# Math Library
import math

print("Square Root:", math.sqrt(25))
print("Factorial:", math.factorial(5))
print("Power:", math.pow(2, 3))
print("Ceiling:", math.ceil(4.3))
print("Floor:", math.floor(4.7))
print("Pi:", math.pi)
print("Euler Number:", math.e)


# NumPy Library
import numpy as np

arr = np.array([1, 2, 3, 4, 5])

print("\nArray:", arr)
print("Mean:", np.mean(arr))
print("Sum:", np.sum(arr))
print("Maximum:", np.max(arr))

matrix = np.array([[1, 2], [3, 4]])

print("\nMatrix:")
print(matrix)

print("Transpose:")
print(matrix.T)


# Matplotlib
import matplotlib.pyplot as plt

x = [1, 2, 3, 4, 5]
y = [10, 20, 30, 40, 50]

plt.plot(x, y)
plt.xlabel("X Axis")
plt.ylabel("Y Axis")
plt.title("Simple Line Graph")
plt.show()


# Seaborn
import seaborn as sns

data = [10, 20, 30, 40, 50]

sns.histplot(data)
plt.title("Histogram")
plt.show()


# SciPy
from scipy import stats

data = [5, 10, 15, 20, 25]

print("\nSciPy Mean:", stats.tmean(data))
print("SciPy Median:", np.median(data))
print("SciPy Mode:", stats.mode(data))
